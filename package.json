{
  "name": "rag-multitenant-evals",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant RAG prototype with Postgres RLS isolation, hybrid search and an eval harness that measures accuracy, refusals, leakage and cost.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "tsx src/setup-tenants.ts",
    "ingest": "tsx src/ingest.ts",
    "ask": "tsx src/ask.ts",
    "eval": "tsx evals/run.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "openai": "^4.67.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
