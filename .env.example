# Copy to .env and fill in. NEVER commit .env.

# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Service role bypasses RLS. Used ONLY by setup and ingestion scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Password for the two demo tenant users (aurora@demo.local, lumen@demo.local)
TENANT_PASSWORD=change-me-to-something-long

# OpenAI
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
ANSWER_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini

# Retrieval experiment knobs
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RETRIEVAL_MODE=hybrid   # hybrid | vector
TOP_K=5
MIN_SIMILARITY=0.25     # below this, refuse without calling the LLM

# Prices in USD per 1M tokens. Verify on the provider pricing page before trusting cost numbers.
PRICE_EMBED_PER_M=0.02
PRICE_ANSWER_IN_PER_M=0.15
PRICE_ANSWER_OUT_PER_M=0.60
